# Copy this file to .env and edit your local PostgreSQL credentials.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/enterprise_pm_db
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
RESET_TOKEN_EXPOSE=true
